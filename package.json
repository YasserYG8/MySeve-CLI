{
  "name": "yassergombra",
  "version": "1.0.2",
  "description": "Interactive Terminal CV of Yasser Gombra",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "yassergombra": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"try { require('fs').chmodSync('dist/index.js', 493) } catch(e) {}\"",
    "start": "bun run src/index.tsx",
    "dev": "bun --watch run src/index.tsx"
  },
  "dependencies": {
    "openai": "^4.28.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "figlet": "^1.7.0",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "typescript": "^5.3.3"
  }
}
